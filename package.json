{
  "name": "demiurge",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./internal/testing": {
      "types": "./src/internal/testing.ts",
      "default": "./src/internal/testing.ts"
    },
    "./vite": {
      "types": "./src/vite/index.ts",
      "default": "./src/vite/index.ts"
    }
  },
  "scripts": {
    "dev": "vite examples/basic-blog",
    "build": "tsc --noEmit && npm run build:example",
    "build:example": "vite build examples/basic-blog",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "jsdom": "^30.0.1",
    "vitest": "^4.1.10"
  }
}
